# ── Audience analytics (dummy figures) ──
# Every value below is a FAKE number shown in the "Audience analytics" card.
# They are read at BUILD TIME (this site is a static export inlined into the
# nginx image), so after editing them you must REBUILD the Docker image for the
# change to appear. Copy this file to `.env.local` to override the defaults.
#
#   *_BASE   = the number the figure hovers around. Bump these up as the real
#              social numbers grow.
#   *_JITTER = how far the figure drifts up AND down from its base during the
#              live animation. Keep it small so it looks natural; set 0 to
#              freeze that figure exactly at its base.

# IG + TikTok · Followers
NEXT_PUBLIC_FOLLOWERS_BASE=5000
NEXT_PUBLIC_FOLLOWERS_JITTER=15

# IG + TikTok · Views
NEXT_PUBLIC_VIEWS_BASE=1000000
NEXT_PUBLIC_VIEWS_JITTER=600

# Bola Aja YT · Subscribers
NEXT_PUBLIC_SUBS_BASE=20000
NEXT_PUBLIC_SUBS_JITTER=20

# Bola Aja YT · Views
NEXT_PUBLIC_YT_VIEWS_BASE=36000000
NEXT_PUBLIC_YT_VIEWS_JITTER=4000

# "+X today" views ticker seed (drifts up slowly during a session)
NEXT_PUBLIC_VIEWS_TODAY_BASE=14382
