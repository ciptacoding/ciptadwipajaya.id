# Audience analytics (dummy figures) — read at BUILD time by `next build` and
# inlined into the static export, so this file is committed and flows into the
# Docker image via `COPY . .`. Edit a value here and rebuild the image to change
# what the "Audience analytics" card shows. See .env.example for what each does.
# For local-only experiments, put overrides in .env.local (gitignored).

NEXT_PUBLIC_FOLLOWERS_BASE=5000
NEXT_PUBLIC_FOLLOWERS_JITTER=15

NEXT_PUBLIC_VIEWS_BASE=1000000
NEXT_PUBLIC_VIEWS_JITTER=600

NEXT_PUBLIC_SUBS_BASE=20000
NEXT_PUBLIC_SUBS_JITTER=20

NEXT_PUBLIC_YT_VIEWS_BASE=36000000
NEXT_PUBLIC_YT_VIEWS_JITTER=4000

NEXT_PUBLIC_VIEWS_TODAY_BASE=14382
